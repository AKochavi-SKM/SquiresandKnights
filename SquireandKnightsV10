  emperor:"Emperor (king): placed once, during setup",
  rotateLeft:"Rotate a field left (counter-clockwise)",
  rotateRight:"Rotate a field right (clockwise)"
};
const HINTS={
  squire:"Place Squire: click an empty square directly beside one of your pieces.",
  knight:"Place Knight: click a highlighted square. It must capture.",
  marshal:"Deploy Marshal: click any empty square on a field where you have 3+ Squires.",
  marshalMove:"Move Marshal: click a highlighted square (red ring = capture).",
  emperor:"Place your Emperor: click a highlighted square in your 3×3 or 5×5 field.",
  rotateLeft:"Rotate Left: click any square on a highlighted field.",
  rotateRight:"Rotate Right: click any square on a highlighted field."
};

const opponent=()=>$("opponent").value;
const vsAI=()=>opponent()!=="human";
const nameOf=color=>color==="black"&&vsAI()?"Black AI":cap(color);
const activeColor=()=>game.phase==="setup"?ui.setupSide:game.turn;
const isRotate=a=>a==="rotateLeft"||a==="rotateRight";
function humanTurn(){
  if(game.over||ui.busy||ui.animating)return false;
  const c=activeColor();
  return !!c&&(c==="white"||!vsAI());
}

function bounds(){
  return LAYOUTS[game.layoutName].positions.reduce((out,p,i)=>({
    cols:Math.max(out.cols,p.x+SIZES[i]),rows:Math.max(out.rows,p.y+SIZES[i])}),{cols:0,rows:0});
}
function computeCell(){
  const fit=Math.floor(($("workspaceWrap").clientWidth-42)/bounds().cols);
  return Math.max(30,Math.min(46,fit||46));
}
const squareLabel=sq=>`${FIELD_NAMES[sq.f]} row ${sq.r+1} col ${sq.c+1}`;

function actionAvailable(action,color){
  if(game.over)return false;
  if(game.phase==="setup")return action==="emperor"&&color===ui.setupSide;
  if(action==="emperor")return false;
  if(isRotate(action))return SIZES.some((_,f)=>canRotate(game,f,color,action==="rotateRight"?1:-1));
  if(action==="marshalMove")return findPieces(game,color,"marshal").length>0;
  if(action==="marshal")return !game.marshalUsed[color]&&SIZES.some((_,f)=>countField(game,color,f,"squire")>=MARSHAL_MIN_SQUIRES);
  return legalTargetKeys(action,color).size>0;
}

function legalTargetKeys(action,color){
  const keys=new Set();
  if(action==="squire"||action==="knight"||action==="marshal"||action==="emperor"){
    game.fields.forEach((field,f)=>field.grid.forEach((row,r)=>row.forEach((_,c)=>{
      const ok=action==="emperor"?canPlaceEmperor(game,color,{f,r,c}):canPlace(game,action,f,r,c,color);
      if(ok)keys.add(keyOf({f,r,c}));
    })));
  }else if(action==="marshalMove"){
    if(ui.selected)marshalTargets(game,ui.selected,color).forEach(s=>keys.add(keyOf(s)));
    else findPieces(game,color,"marshal").forEach(s=>keys.add(keyOf(s)));
  }
  return keys;
}

/* ---------- actions ---------- */

function say(text){ui.message=text;render()}

// Each player's last move choice stays selected between turns (legal targets stay highlighted).
function restoreAction(color){
  ui.action=null;ui.selected=null;
  if(!color||game.over||game.phase==="setup"||(vsAI()&&color==="black"))return;
  let a=ui.lastAction[color];
  if(a==="marshal"&&game.marshalUsed[color])a=null;          // deploying is once-only: don't auto-arm "move"
  if(!a||!actionAvailable(a,color))return;
  ui.action=a;
  if(a==="marshalMove"){const m=findPieces(game,color,"marshal");if(m.length===1)ui.selected=m[0]}
}

function chooseAction(action){
  if(!humanTurn())return;
  const color=activeColor();
  ui.selected=null;
  if(ui.action===action&&game.phase!=="setup"){ui.action=null;ui.lastAction[color]=null;return say("Move cancelled. Pick a move.")}
  if(!actionAvailable(action,color)){ui.action=null;return say("That move isn't available right now.")}
  ui.action=action;
  if(game.phase==="play")ui.lastAction[color]=action;
  if(action==="marshalMove"){
    const mine=findPieces(game,color,"marshal");
    if(mine.length===1)ui.selected=mine[0];
  }
  say(HINTS[action]);
}

function clickCell(f,r,c){
  if(!humanTurn())return;
  const color=activeColor(),target={f,r,c},piece=at(game,target);

  if(game.phase==="setup"){
    if(canPlaceEmperor(game,color,target)){
      game.picks[color]=target;
      return say("Emperor placed (only you can see it). Click another square to change it, or press Confirm Emperor.");
    }
    return say("Pick a highlighted square in your own 3×3 or 5×5 field. Squares where the Emperor could never be captured (like some board-edge corners) are not allowed.");
  }

  if(!ui.action)return say("Pick a move first (panel under the board).");
  const action=ui.action;

  if(action==="marshalMove"){
    if(!ui.selected){
      if(piece&&piece.color===color&&piece.kind==="marshal"){ui.selected=target;return say("Marshal selected. Click a highlighted square.")}
      return say("Click your Marshal first.");
    }
    if(marshalTargets(game,ui.selected,color).some(s=>keyOf(s)===keyOf(target)))
      return play({type:"marshalMove",from:ui.selected,to:target});
    return say("The Marshal moves one square in any direction within its own field, onto an empty or enemy square.");
  }

  if(isRotate(action)){
    const dir=action==="rotateRight"?1:-1;
    if(canRotate(game,f,color,dir))return play({type:"rotate",f,dir});
    if(MODES[game.mode].marshalLocksRotation!==false&&hasMarshal(game,f,other(color)))return say("Blocked: an enemy Marshal is on that field.");
    if(!countField(game,color,f,"squire"))return say("You need at least one Squire on that field to rotate it.");
    return say("That rotation would leave an Emperor on a square that can never be flanked, so it isn't allowed.");
  }

  if(canPlace(game,action,f,r,c,color))return play({type:"place",kind:action,f,r,c});
  say({
    squire:"Squires go on an empty square directly beside one of your pieces.",
    knight:"A Knight must capture: bracket enemy pieces in a straight line against another of your pieces.",
    marshal:"Deploy the Marshal on an empty square of a field where you have 3+ Squires (once per game)."
  }[action]);
}

function describeMove(move){
  if(move.type==="place")return`placed a ${cap(move.kind)} at ${squareLabel(move)}`;
  if(move.type==="marshalMove")return`moved the Marshal to ${squareLabel(move.to)}`;
  return`rotated ${FIELD_NAMES[move.f]} ${move.dir===1?"right":"left"}`;
}

function snapshot(){return{state:cloneState(game),logLen:ui.log.length,positions:new Map(ui.positions)}}

function play(move){
  ui.history.push(snapshot());
  const color=game.turn,moveNo=Math.floor(game.ply/2)+1;
  const result=applyMove(game,move);

  if(!game.over){                                   // threefold repetition = draw
    const key=positionKey(game),n=(ui.positions.get(key)||0)+1;
    ui.positions.set(key,n);
    if(n>=3)declareDraw(game,"Draw: the same position occurred three times.");
  }

  const lost=result.captured.length+(result.landed?1:0);
  ui.last=result.touched;ui.landed=result.landed?[result.landed]:[];
  restoreAction(game.over?null:activeColor());
  const what=describeMove(move);

  ui.log.push(`${moveNo}. ${nameOf(color)} ${what}.`+(lost?` Captured ${lost}.`:"")+
    (result.gained?` +${result.gained}.`:""));
  ui.message=`${nameOf(color)} ${what}.`+
    (lost?` Captured ${lost} piece${lost===1?"":"s"}.`:"")+
    (result.gained?` +${result.gained} point${result.gained===1?"":"s"}.`:"")+
    (game.over?` GAME OVER — ${game.endReason}`:` ${nameOf(game.turn)} to move.`);
  if(game.over)ui.log.push(game.winner?`Result: ${game.endReason} (${cap(game.winner)} wins)`:`Result: ${game.endReason}`);

  if(lost){
    ui.animating=true;
    const g=game;
    setTimeout(()=>finishFlash(g),1000);
  }
  render();
  if(!lost)maybeRunAI();
}

function finishFlash(g){
  settle(g);
  if(g!==game)return;
  ui.animating=false;ui.landed=[];
  render();
  maybeRunAI();
}

function maybeRunAI(){
  if(!vsAI()||game.phase==="setup"||game.turn!=="black"||game.over||ui.animating||ui.busy)return;
  const g=game;
  ui.busy=true;
  ui.message="Black AI is choosing a move…";
  render();
  setTimeout(()=>{
    if(g!==game)return;
    let move=null;
    try{move=chooseAI(g,opponent(),"black",ui.positions)}catch(error){console.error(error)}
    ui.busy=false;
    if(move)play(move);
    else{g.over=true;g.endReason="The AI could not move.";ui.message=g.endReason;render()}
  },40);
}

// Undo: against the computer, rewinds to your previous turn (undoes its reply too).
function undo(){
  if(ui.busy||ui.animating||!ui.history.length)return;
  let entry;
  do{entry=ui.history.pop()}while(vsAI()&&entry.state.turn!=="white"&&ui.history.length);
  game=entry.state;
  ui.log.length=entry.logLen;
  ui.positions=entry.positions;
  Object.assign(ui,{last:[],landed:[]});
  restoreAction(activeColor());
  ui.message=`Undid the last move. ${nameOf(game.turn)} to move.`;
  render();
  maybeRunAI();
}

// End Game = the player to move forfeits.
function endGame(){
  if(game.over||ui.busy||ui.animating)return;
  if(game.phase==="setup"){startNewGame(true);return}
  if(!confirm(`End the game? ${nameOf(game.turn)} forfeits and ${nameOf(other(game.turn))} wins.`))return;
  const loser=game.turn;
  finish(game,other(loser),`${nameOf(loser)} ended the game.`);
  ui.action=null;ui.selected=null;
  ui.log.push(`Result: ${game.endReason} (${cap(game.winner)} wins)`);
  ui.message=`GAME OVER — ${game.endReason} ${nameOf(game.winner)} wins.`;
  render();
}

/* ---------- Emperor mode setup flow ---------- */

function confirmEmperor(){
  const side=ui.setupSide;
  if(!side||!game.picks[side])return say("Click a highlighted square in your 3×3 or 5×5 field to place your Emperor first.");
  if(side==="white"&&!vsAI()){
    ui.setupSide="black";ui.action="emperor";
    return say("White's Emperor is hidden. Pass the screen to Black: place your Emperor (White, look away!).");
  }
  if(vsAI())game.picks.black=chooseEmperorSquare(game,"black",opponent());
  revealEmperors(game);
  ui.setupSide=null;ui.action=null;
  ui.positions=new Map([[positionKey(game),1]]);
  ui.log.push("Both Emperors revealed.");
  ui.message="Both Emperors are revealed. White to move.";
  render();
  maybeRunAI();
}

function startNewGame(first=false){
  if(!first&&game&&!game.over&&game.ply>0&&!confirm("Start a new game? The current game will be lost."))return false;
  const mode=$("mode").value;
  game=createGame({layoutName:$("layout").value,mode,target:Number($("target").value)||DEFAULT_TARGET,emperorSetup:mode==="emperor"});
  Object.assign(ui,{action:null,selected:null,lastAction:{white:null,black:null},busy:false,animating:false,setupSide:null,
    last:[],landed:[],log:[],history:[],positions:new Map()});
  $("rules").innerHTML=rulesHTML(game.mode);
  syncModeControls();
  if(game.phase==="setup"){
    ui.setupSide="white";ui.action="emperor";
    ui.message=vsAI()
      ?"Place your Emperor in your 3×3 or 5×5 field. The computer places its own in secret; both are revealed when you confirm."
      :"White: place your Emperor in your 3×3 or 5×5 field (Black, look away!).";
  }else{
    ui.positions.set(positionKey(game),1);
    ui.message="White to move. Pick a move from the panel under the board; it stays selected between turns.";
  }
  render();
  maybeRunAI();
  return true;
}
const TARGET_OPTIONS={
  hill:{values:[51,75,100],def:100},
  plurality:{values:[11,15,30,50,75],def:50}
};
function syncModeControls(){
  const m=$("mode").value;
  $("targetLabel").hidden=m==="emperor";
  const t=TARGET_OPTIONS[m];
  if(t&&$("target").dataset.mode!==m){
    $("target").innerHTML=t.values.map(v=>`<option value="${v}"${v===t.def?" selected":""}>${v} points</option>`).join("");
    $("target").dataset.mode=m;
  }
}

/* ---------- rendering ---------- */

function rotationMark(f,color){
  if(MODES[game.mode].marshalLocksRotation!==false&&hasMarshal(game,f,other(color)))return"🔒";
  return countField(game,color,f,"squire")?"✓":"—";
}
function marshalState(color){
  if(!game.marshalUsed[color])return"Available";
  return findPieces(game,color,"marshal").length?"On the board":"Captured";
}
const emperorState=color=>game.phase==="setup"?"being placed":
  findPieces(game,color,"emperor").length?"standing":"<strong>captured</strong>";

function rulesHTML(mode){
  const emp=mode==="emperor",plur=mode==="plurality",hill=!emp,lock=MODES[mode].marshalLocksRotation!==false;
  const goal=emp
    ?`<strong>Goal.</strong> Capture the enemy <strong>Emperor</strong>. Your Emperor drives your campaign; the game ends the moment either Emperor is captured. There are no points and fields have no value in this mode. You also win instantly if your opponent has no legal move.`
    :plur
    ?`<strong>Goal.</strong> Bank points by holding fields, but a field only counts once you have at least <em>half the board</em> of presence on it (5 on a 3×3, 13 on a 5×5, 25 on the 7×7) and more presence than your opponent. The first side to reach the target wins. You also win instantly if your opponent has no Squires left on the board, or no legal move.`
    :`<strong>Goal.</strong> Hold the majority of influence on fields to bank points every turn. The first side to reach the target (default 100) wins. You also win instantly if your opponent has no Squires left on the board, or no legal move.`;
  const board=`
      <li>Five fields touch each other: a small 3×3 home field for each side, two 5×5 fields, and the big 7×7 in the middle. Lines, flanks and placement all continue across field seams.</li>`+
    (hill?`<li>Each side starts with three Squires in a line on its home 3×3. White moves first.</li>`
         :`<li>Each side starts with <strong>only its Emperor</strong>. Squires are placed beside it (or beside any piece you already have), so your army grows outward from the Emperor. White moves first.</li>`)+`
      <li><strong>Piece key</strong> (the move panel under the board; your last choice stays selected between turns, and Esc or pressing it again clears it): ♙ pawn = Squire · ♘ knight = Knight · ♖ rook = Marshal${hill?"":" · ♔ king = Emperor"} · ↺ ↻ = rotate a field.</li>`+
    (hill?`<li>Field border colour shows who holds it (blue = White, red = Black, grey = nobody).</li>`
      :`<li><strong>Emperor setup.</strong> Before move 1, each side places its Emperor on any empty highlighted square of its own 3×3 or its own 5×5 (never the 7×7). White places first, then Black, and neither placement is shown until both are confirmed (on a shared screen, the other player looks away). The Emperor is never moved or placed again, but rotating its field carries it along. It counts as one of your pieces: you can place beside it, and it can be one end of a flank. It is captured by the normal flank rules or by a Marshal moving onto it.</li>
      <li><strong>Safe-square rule.</strong> Some squares (like board-edge corners) can never be flanked, so a piece parked there could never be captured. An Emperor must sit where a flank line exists whose two squares can both be flanked, so no defender can wall it in permanently. A rotation that would carry an Emperor onto a square that fails this isn't allowed.</li>`);
  const rotate=`Turn a whole field 90° (every piece on it moves). You need at least one Squire on that field${lock?", and the opponent must not have a Marshal there":""}. Right is clockwise.`;
  const marshal=`Once per game, on any empty square of a field where you have at least three Squires. After that the same icon moves it.`+
    (lock?` A Marshal on a field stops the opponent from rotating it (you can still rotate it yourself).`:` (A Marshal does not lock rotation in this mode.)`);
  const st=MODES[mode].startTurn||START_TURN;
  const ord=n=>n+({1:"st",2:"nd",3:"rd"}[n]||"th");
  const startText=st.white===st.black?`Scoring begins on turn ${st.white} for both players.`:`Scoring begins on White’s ${ord(st.white)} turn and Black’s ${ord(st.black)} turn.`;
  const scoring=plur?`
    <h3>Fields, presence and points (Plurality)</h3>
    <ul>
      <li>Presence on a field: Squire 1, Knight 2, Marshal 3.</li>
      <li>A field scores for you only when your presence is at least half the squares plus one — <strong>5 of 9</strong> on a 3×3, <strong>13 of 25</strong> on a 5×5, <strong>25 of 49</strong> on the 7×7 — and is higher than your opponent’s. If both of you reach the number, the higher presence holds it; equal holds nothing.</li>
      <li>Field values: 3×3 = 1, 5×5 = 2, 7×7 = 3. Each field you hold is banked at the end of every one of your turns. ${startText}</li>
      <li>Targets are checked after Black’s turn so both sides get equal turns. If both sides are tied at or above the target, whoever has more total presence on the board wins; if that is level too, play continues.</li>
      <li>Because a field has to be nearly half full before it scores, this mode is slower: building up, flanking and rotating fields to break up the other side’s lines all matter.</li>
    </ul>`
    :hill&&!emp?`
    <h3>Fields, influence and points</h3>
    <ul>
      <li>Influence on a field: Squire 1, Knight 1, Marshal 2. More influence holds the field; a tie holds nothing.</li>
      <li>Field values: 3×3 = 1, 5×5 = 2, 7×7 = 3. Each field you hold is banked at the end of every one of your turns.</li>
      <li>${startText}</li>
      <li>Targets are checked after Black’s turn so both sides get equal turns. If both sides are tied at or above the target, whoever holds the 7×7 wins; if nobody does, play continues.</li>
    </ul>`:"";
  return`<h2>How to play — ${MODES[mode].label}</h2>
    <div>${goal}</div>
    <h3>The board</h3><ul>${board}</ul>
    <h3>Your turn: press one icon, then click the board</h3>
    <ul>
      <li><strong>Place Squire</strong> (pawn) – on any empty square directly (up/down/left/right) beside one of your pieces${hill?"":", including your Emperor"}.</li>
      <li><strong>Place Knight</strong> – only on a square where it <em>captures</em>: in a straight row or column, the Knight and another of your pieces (Squire, Knight${hill?"":", Emperor"} or Marshal) must bracket one or more enemy pieces. Knights never move and are unlimited.</li>
      <li><strong>Marshal</strong> (rook) – deploy: ${marshal}<br>Move: one square in any direction (including diagonals) inside its own field, onto an empty square or an enemy piece, which it captures. It cannot move onto your own pieces.</li>
      <li><strong>Rotate Left / Right</strong> – ${rotate}</li>
    </ul>
    <h3>Captures</h3>
    <ul>
      <li>A line of one or more enemy pieces (no gaps) between two of your pieces is captured. The two ends can be any of your pieces.</li>
      <li>Captures happen on <em>your</em> move and only for lines involving the piece you just placed or moved. After a <strong>rotation</strong>, every flank that touches the rotated field captures, so you can rotate a board into captures.</li>
      <li>A piece that is placed or moved <em>between</em> two enemy pieces is safe. It can only be lost to a later flank that involves a piece the enemy places or moves, or a rotation of its field.</li>
      <li>A Marshal can be captured like any other piece. Captured pieces flash twice and are removed.</li>
    </ul>${scoring}
    <h3>Draws and ending early</h3>
    <ul>
      <li>If the same position (same pieces, same player to move${hill?", same score":""}) occurs three times, the game is a draw.</li>
      <li><strong>End Game</strong> makes the player to move forfeit.</li>
    </ul>`;
}

function emperorPanelHTML(){
  const rows=SIZES.map((_,f)=>`<tr><td>${FIELD_NAMES[f]}</td><td>W ${rotationMark(f,"white")} · B ${rotationMark(f,"black")}</td></tr>`).join("");
  const lock=MODES.emperor.marshalLocksRotation!==false;
  return`<h2>Emperor</h2>
    <div><strong>Emperors:</strong> White ${emperorState("white")} · ${nameOf("black")} ${emperorState("black")}</div>
    <table><tr><th>Field</th><th>Can rotate?</th></tr>${rows}</table>
    <div class="legend muted"><span>✓ can rotate</span>${lock?"<span>🔒 blocked by enemy Marshal</span>":""}<span>— needs a Squire there</span></div>`;
}

function scoringHTML(){
  if(game.mode==="emperor")return emperorPanelHTML();
  const plur=game.mode==="plurality";
  const rows=SIZES.map((_,f)=>{
    const i=fieldInfluence(game,f),owner=fieldOwner(game,f);
    return`<tr><td>${FIELD_NAMES[f]}${f===BIG_FIELD?" ★":""}</td><td>${FIELD_VALUE[f]}</td>
      ${plur?`<td>${fieldThreshold(f)} of ${SIZES[f]*SIZES[f]}</td>`:""}
      <td>${i.white}</td><td>${i.black}</td>
      <td>${owner?`<strong>${nameOf(owner)}</strong>`:'<span class="muted">Nobody</span>'}</td>
      <td>W ${rotationMark(f,"white")} · B ${rotationMark(f,"black")}</td></tr>`;
  }).join("");
  const s=score(game);
  const status=color=>s[color].scoring?`scoring (+${s[color].fields}/turn)`
    :`scoring opens on turn ${startTurnOf(game,color)} (turns taken: ${s[color].turns})`;
  const weights=plur?"Presence: Squire 1 · Knight 2 · Marshal 3":"Influence: Squire 1 · Knight 1 · Marshal 2";
  return`<h2>Fields &amp; scoring</h2>
    <table>
      <tr><th>Field</th><th>Value / turn</th>${plur?"<th>Needed to score</th>":""}<th>White ${plur?"presence":"influence"}</th><th>Black ${plur?"presence":"influence"}</th><th>Held by</th><th>Can rotate?</th></tr>
      ${rows}
    </table>
    <div class="legend muted"><span>${weights}</span><span>✓ can rotate</span><span>🔒 blocked by enemy Marshal</span><span>— needs a Squire there</span><span>★ tiebreaker field</span></div>
    <div class="legend muted" style="margin-top:4px">
      <span><i class="sw" style="background:#0072bc"></i>held by White</span>
      <span><i class="sw" style="background:#c0392b"></i>held by Black</span>
      <span><i class="sw" style="background:#8a8a8a"></i>nobody</span></div>
    <div><strong>White:</strong> ${s.white.total} / ${game.target} — ${status("white")}</div>
    <div><strong>${nameOf("black")}:</strong> ${s.black.total} / ${game.target} — ${status("black")}</div>`;
}

// Move panels sit above the board (never on it): one per human player.
function panelsHTML(){
  const colors=vsAI()?["white"]:["white","black"];
  return colors.map(color=>{
    const live=humanTurn()&&activeColor()===color;
    const mk=(action,glyph,caption,extra="")=>{
      const on=live&&actionAvailable(action,color),armed=live&&ui.action===action;
      return`<button class="pal ${color}${extra}${armed?" armed":""}" data-action="${action}" data-side="${color}" title="${TIPS[action]}" aria-label="${TIPS[action]}"${on?"":" disabled"}><span class="g">${glyph}</span><small>${caption}</small></button>`;
    };
    const marshalAct=game.marshalUsed[color]?"marshalMove":"marshal";
    const pieces=[mk("squire",GLYPH[color].squire,"Squire"),mk("knight",GLYPH[color].knight,"Knight"),
      mk(marshalAct,GLYPH[color].marshal,marshalAct==="marshal"?"Deploy Marshal":"Move Marshal")];
    if(game.mode==="emperor")pieces.push(mk("emperor",GLYPH[color].emperor,"Emperor"));
    const title=nameOf(color)+(game.over?"":live?" — your move":" — waiting");
    return`<div class="mpanel ${color}${live?" live":""}"><div class="mp-title">${title}</div>
      <div class="mp-groups">
        <div class="mp-group"><span class="mp-label">Place / use a piece</span><div class="mp-btns">${pieces.join("")}</div></div>
        <div class="mp-group"><span class="mp-label">Rotate a field</span><div class="mp-btns">${mk("rotateLeft","↺","Left"," rot")}${mk("rotateRight","↻","Right"," rot")}</div></div>
      </div></div>`;
  }).join("");
}

function render(){
  const cell=computeCell();
  document.documentElement.style.setProperty("--cell",cell+"px");
  document.documentElement.style.setProperty("--glyph",Math.round(cell*.68)+"px");

  const hill=MODES[game.mode].usesPoints,setup=game.phase==="setup";   // `hill` = a points mode (Hill or Plurality)
  const points=hill?score(game):null,size=bounds(),color=activeColor(),mine=humanTurn();
  $("status").textContent=`${game.over?"Game over":setup?"Setup":nameOf(game.turn)+" to move"}${ui.busy?" — thinking":""} • ${ui.message}`;
  $("status").classList.toggle("over",game.over);

  $("scores").innerHTML=["white","black"].map(c=>{
    const squires=countPieces(game,c,"squire");
    return`<div class="score${!game.over&&color===c?" turn":""}"><strong>${nameOf(c)}</strong><br>
      ${hill?`Points: <strong>${points[c].total}</strong> / ${game.target}<br>
      Fields held now: ${points[c].fields} pt/turn<br>
      Turns taken: ${points[c].turns} (scoring from turn ${startTurnOf(game,c)})<br>`
        :`Emperor: ${emperorState(c)}<br>Turns taken: ${game.turns[c]}<br>`}
      Squires: <span class="${hill&&squires<=2?"warn":""}">${squires}</span> · Knights: ${countPieces(game,c,"knight")}<br>
      Marshal: ${marshalState(c)}</div>`;
  }).join("");

  $("scoringPanel").innerHTML=scoringHTML();
  $("movePanels").innerHTML=panelsHTML();
  $("undoBtn").disabled=!ui.history.length||ui.busy||ui.animating;
  $("endGame").disabled=game.over||ui.busy||ui.animating;

  $("setupBar").hidden=!setup||game.over;
  if(setup&&!game.over){
    $("setupText").textContent=`${cap(ui.setupSide||"white")}: place your Emperor in your 3×3 or 5×5 field (highlighted squares).`+
      (vsAI()?" The computer places its own in secret.":ui.setupSide==="white"?" (Black, look away!)":" (White, look away!)");
    $("confirmEmperor").disabled=!mine||!game.picks[ui.setupSide];
  }

  // board
  const targets=mine&&ui.action&&!isRotate(ui.action)?legalTargetKeys(ui.action,color):new Set();
  const rotatable=mine&&isRotate(ui.action)?new Set(SIZES.map((_,f)=>f).filter(f=>canRotate(game,f,color,ui.action==="rotateRight"?1:-1))):null;
  const active=document.activeElement;
  const focusSel=active&&active.dataset&&active.dataset.f!==undefined?
    `[data-f="${active.dataset.f}"][data-r="${active.dataset.r}"][data-c="${active.dataset.c}"]`:null;

  const workspace=$("workspace");
  workspace.style.width=`${size.cols*cell}px`;
  workspace.style.height=`${size.rows*cell}px`;
  const pick=setup&&ui.setupSide?game.picks[ui.setupSide]:null;   // only the placing player sees their pick
  workspace.innerHTML=game.fields.map((field,f)=>{
    const p=LAYOUTS[game.layoutName].positions[f],owner=hill?fieldOwner(game,f):null;
    const cells=field.grid.map((row,r)=>row.map((piece,c)=>{
      const key=keyOf({f,r,c});
      let shown=piece,pending=false;
      if(pick&&pick.f===f&&pick.r===r&&pick.c===c){shown={color:ui.setupSide,kind:"emperor"};pending=true}
      const classes=["cell",shown?shown.color:"",
        shown&&shown.removing?"removing":"",
        pending?"pending":"",
        ui.landed.includes(key)?"landed":"",
        ui.last.includes(key)?"last":"",
        targets.has(key)?`legal${shown&&!pending?" enemy":""}`:"",
        ui.selected&&keyOf(ui.selected)===key?"selected":""].join(" ");
      const desc=shown?`${shown.color} ${shown.kind}`:"empty";
      return`<button class="${classes}" data-f="${f}" data-r="${r}" data-c="${c}"
        aria-label="${squareLabel({f,r,c})}: ${desc}">${shown?`<span class="pc">${GLYPH[shown.color][shown.kind]}</span>`:""}</button>`;
    }).join("")).join("");
    const fieldClass=["field",rotatable?(rotatable.has(f)?"pick":"dim"):""].join(" ");
    return`<section class="${fieldClass}" style="left:${p.x*cell}px;top:${p.y*cell}px">
      <div class="grid held-${owner||"none"}" style="grid-template-columns:repeat(${field.size},${cell}px)">${cells}</div>
    </section>`;
  }).join("");
  if(focusSel){const el=workspace.querySelector(focusSel);if(el)el.focus({preventScroll:true})}

  $("log").innerHTML=ui.log.map(l=>`<li>${l.replace(/^\d+\.\s/,"")}</li>`).join("");
}

/* ---------- wiring ---------- */

$("movePanels").addEventListener("click",event=>{
  const pal=event.target.closest("[data-action]");
  if(pal&&!pal.disabled)chooseAction(pal.dataset.action);
});
$("workspace").addEventListener("click",event=>{
  const b=event.target.closest("[data-f]");
  if(b)clickCell(+b.dataset.f,+b.dataset.r,+b.dataset.c);
});
document.addEventListener("keydown",event=>{
  if(event.key==="Escape"&&ui.action&&game.phase!=="setup"){
    ui.lastAction[activeColor()]=null;ui.action=null;ui.selected=null;say("Move cancelled. Pick a move.");
  }
});
$("newGame").addEventListener("click",()=>startNewGame());
$("endGame").addEventListener("click",endGame);
$("undoBtn").addEventListener("click",undo);
$("confirmEmperor").addEventListener("click",confirmEmperor);
// Choosing a mode or layout starts that game straight away (asks first if a game is under way).
for(const id of["mode","layout"])$(id).addEventListener("change",()=>{
  syncModeControls();
  if(!startNewGame()){$("mode").value=game.mode;$("layout").value=game.layoutName;syncModeControls()}
});
$("target").addEventListener("change",()=>{
  game.target=Number($("target").value)||DEFAULT_TARGET;
  say(`Target set to ${game.target} points.`);
});
$("opponent").addEventListener("change",()=>{render();maybeRunAI()});
$("copyLog").addEventListener("click",()=>{
  const text=[`Squires & Rotations — mode: ${MODES[game.mode].label}, layout: ${LAYOUTS[game.layoutName].label}, opponent: ${opponent()}`,
    ...ui.log].join("\n");
  (navigator.clipboard?navigator.clipboard.writeText(text):Promise.reject()).catch(()=>{
    const t=document.createElement("textarea");t.value=text;document.body.appendChild(t);t.select();
    try{document.execCommand("copy")}catch(e){}t.remove();
  });
});
let resizeTimer;
window.addEventListener("resize",()=>{clearTimeout(resizeTimer);resizeTimer=setTimeout(render,120)});

if(new URLSearchParams(location.search).has("debug")){
  $("tests").hidden=false;
  $("tests").addEventListener("click",()=>{
    const out=$("testOutput");out.hidden=false;
    const results=runRuleTests();
    out.textContent=`${results.filter(r=>r.startsWith("PASS")).length}/${results.length} passed\n`+results.join("\n");
  });
}

startNewGame(true);
</script>
</body>
</html>
