<title>Squires &amp; Rotations</title>
<style>
:root{--green:#86BC25;--dark:#282728;--blue:#005587;--tile:#e7e4de;--cell:42px;--glyph:28px;--hold:#8a8a8a}
*{box-sizing:border-box}
body{margin:0;background:#f5f5f5;color:#171717;font:14px/1.4 Arial,sans-serif}
header{padding:20px 24px;background:var(--dark);color:#fff;border-bottom:5px solid var(--green)}
h1{margin:0 0 5px;font-size:27px}
main{max-width:1600px;margin:auto;padding:16px}
.toolbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:12px}
button,select{font:inherit;padding:8px 10px;border:1px solid #aaa;border-radius:4px;background:#fff}
button{cursor:pointer}
button:hover:not(:disabled){border-color:var(--green)}
button:disabled{opacity:.48;cursor:not-allowed}
button.primary{background:var(--blue);color:#fff;border-color:var(--blue);font-weight:bold}
