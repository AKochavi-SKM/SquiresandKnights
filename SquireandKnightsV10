.pal .g{font-size:30px;line-height:1}
.pal small{font-size:11px;line-height:1.1;text-align:center;color:#333;text-shadow:none}
.pal.white .g{color:#fff;text-shadow:1px 1px 2px #111,-1px -1px 2px #111}
.pal.black .g{color:#111;text-shadow:1px 1px 2px #fff,-1px -1px 2px #fff}
