.cell .pc{display:block;line-height:1;pointer-events:none}
.cell.white{color:#fff;text-shadow:1px 1px 2px #111,-1px -1px 2px #111}
.cell.black{color:#111;text-shadow:1px 1px 2px #fff,-1px -1px 2px #fff}
.cell:hover:not(:disabled){outline:2px solid var(--green);outline-offset:-2px;z-index:3}
