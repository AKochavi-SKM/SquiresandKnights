<body>
<header>
  <h1>Squires &amp; Rotations</h1>
  <div>Connected fields · flank captures · rotating boards</div>
</header>
<main>
  <div class="toolbar">
    <label>Game mode:
      <select id="mode">
        <option value="hill">King of the Hill (points)</option>
        <option value="emperor">Emperor</option>
        <option value="plurality">Plurality (majority of the board)</option>
      </select>
    </label>
    <label>Layout:
      <select id="layout">
        <option value="straight">Straight line</option>
        <option value="zigzag">Zig-zag</option>
        <option value="block">Big block (homes touch the 7×7)</option>
      </select>
    </label>
    <label>Opponent:
      <select id="opponent">
        <option value="normal">Computer – Normal</option>
        <option value="easy">Computer – Easy</option>
        <option value="optimized">Computer – Optimized</option>
        <option value="human">Human (hot-seat, same screen)</option>
      </select>
    </label>
    <label id="targetLabel">Play to:
      <select id="target">
        <option value="51">51 points</option>
        <option value="75">75 points</option>
        <option value="100" selected>100 points</option>
      </select>
    </label>
    <button id="newGame">New Game</button>
    <button id="endGame">End Game</button>
    <button id="undoBtn" disabled>Undo</button>
    <button id="tests" hidden>Run Rule Tests</button>
  </div>

  <div class="setupbar" id="setupBar" hidden>
    <span id="setupText"></span>
    <button id="confirmEmperor" class="primary">Confirm Emperor</button>
  </div>

  <div id="status" role="status" aria-live="polite"></div>
  <div id="scores" class="scores"></div>
  <div class="workspace-wrap" id="workspaceWrap"><div id="workspace" class="workspace"></div></div>
  <div id="movePanels" class="move-panels"></div>
  <div id="scoringPanel" class="panel scoring"></div>

  <div class="panel" id="rules"></div>

  <details class="panel" id="logPanel">
    <summary><strong>Move log</strong> (copy it into your beta-test feedback)</summary>
    <ol id="log"></ol>
    <button id="copyLog">Copy log</button>
  </details>

  <pre id="testOutput" hidden></pre>
</main>

<script>
"use strict";

//#ENGINE_START
/* =====================================================================
   ENGINE – pure game rules and AI. No DOM access in this block.
   ===================================================================== */

const SIZES=[3,5,7,5,3];
const FIELD_NAMES=["W 3×3","W 5×5","Center 7×7","B 5×5","B 3×3"];
const FIELD_VALUE=[1,2,3,2,1];          // points per turn for holding each field
const BIG_FIELD=2;                      // the 7×7: tiebreaker field
const DEFAULT_TARGET=100;
const START_TURN={white:4,black:3};     // scoring begins on each side's Nth turn (a mode can override with its own startTurn)
const MARSHAL_RANGE=1;                  // 1 = the surrounding 3×3
const MARSHAL_MIN_SQUIRES=3;
const KINDS=["squire","knight","marshal"];
const ORTHO=[[1,0],[-1,0],[0,1],[0,-1]];                 // [dy,dx]
const INFLUENCE={squire:1,knight:1,marshal:2,emperor:0};
const PIECE_VALUE={squire:1,knight:2,marshal:6,emperor:40};  // AI heuristics only
const STRATEGIC_VALUE={squire:.35,knight:.45,marshal:.6,emperor:0}; // AI heuristics only
const EMPEROR_CAPTURABLE_ONLY=true;      // keep Emperors off squares where no flank could ever be forced
const EMPEROR_START={r:1,c:1};          // centre of the home 3×3: it never moves, even when the field rotates

// Every layout is 180°-point-symmetric: field i maps onto field 4-i.
const LAYOUTS={
  straight:{label:"Straight line",
    positions:[{x:0,y:2},{x:3,y:1},{x:8,y:0},{x:15,y:1},{x:20,y:2}]},
  zigzag:{label:"Zig-zag",
    positions:[{x:0,y:0},{x:0,y:3},{x:5,y:2},{x:12,y:3},{x:14,y:8}]},
  block:{label:"Big block",
    positions:[{x:0,y:2},{x:3,y:0},{x:1,y:5},{x:1,y:12},{x:6,y:12}]}
};

const other=color=>color==="white"?"black":"white";
const cap=text=>text[0].toUpperCase()+text.slice(1);
const keyOf=sq=>`${sq.f}:${sq.r}:${sq.c}`;
const parseKey=key=>{const[f,r,c]=key.split(":").map(Number);return{f,r,c}};
const emptyGrid=n=>Array.from({length:n},()=>Array(n).fill(null));
const inside=(f,r,c)=>r>=0&&c>=0&&r<SIZES[f]&&c<SIZES[f];

/* ---------- game modes ----------
   A mode supplies: setup (extra starting pieces), afterCaptures (win checks tied to
   what was captured), endTurn (scoring etc.) and evaluate (AI heuristic).
   Add a new mode by adding an entry here. */
const MODES={
  hill:{
    label:"King of the Hill",usesPoints:true,
    setup(state){                       // each side's starting Squire road (point-symmetric)
      for(let r=0;r<3;r++){
        state.fields[0].grid[r][0]={color:"white",kind:"squire"};
        state.fields[4].grid[r][2]={color:"black",kind:"squire"};
      }
    },
    afterCaptures(state,color,lost){},
    endTurn(state,color,result){
      const before=state.points[color];
      accrue(state,color);
      result.gained=state.points[color]-before;
      if(color==="black")checkRoundEnd(state);
    },
    evaluate:(state,me)=>evaluateHill(state,me)
  },
  plurality:{
    label:"Plurality",usesPoints:true,
    weights:{squire:1,knight:2,marshal:3,emperor:0},   // how much each piece counts toward a field
    boardMajority:true,                                 // a field scores only with >= half its squares of presence
    startTurn:{white:4,black:4},                        // equal start: with Black's usual head start it won 70-85% of races
    setup(state){MODES.hill.setup(state)},
    afterCaptures(state,color,lost){},
    endTurn(state,color,result){MODES.hill.endTurn(state,color,result)},
    // A tie at the target goes to whoever has more total presence on the board; level still = play on.
    tieBreak(state){
      const t={white:0,black:0};
      for(let f=0;f<SIZES.length;f++){const i=fieldInfluence(state,f);t.white+=i.white;t.black+=i.black}
      return{winner:t.white===t.black?null:t.white>t.black?"white":"black",why:"having more total presence on the board"};
    },
    evaluate:(state,me)=>evaluatePlurality(state,me)
  },
  emperor:{
    label:"Emperor",usesPoints:false,
    marshalLocksRotation:true,            // decided by testing (see notes)
    squireLoss:false,                     // no starting Squires: the Emperor is the objective, not the army
    setup(state){
      state.fields[0].grid[EMPEROR_START.r][EMPEROR_START.c]={color:"white",kind:"emperor"};
      state.fields[4].grid[EMPEROR_START.r][EMPEROR_START.c]={color:"black",kind:"emperor"};
    },
    afterCaptures(state,color,lost){
      if(lost.includes("emperor"))
        finish(state,color,`${cap(color)} captured the ${cap(other(color))} Emperor.`);
    },
    endTurn(){},
    evaluate:(state,me)=>evaluateEmperor(state,me)
  }
};

/* ---------- state ---------- */

function newState({layoutName="straight",target=DEFAULT_TARGET,mode="hill"}={}){
  return{
    layoutName,target,mode,phase:"play",picks:null,
    fields:SIZES.map(size=>({size,rotation:0,grid:emptyGrid(size)})),
    turn:"white",ply:0,over:false,winner:null,endReason:"",
    marshalUsed:{white:false,black:false},
    turns:{white:0,black:0},
    points:{white:0,black:0}
  };
}

// New game. Each mode places its own starting pieces (Hill: a Squire road; Emperor mode: the Emperors).
function createGame(options={}){
  const state=newState(options);
  if(options.emperorSetup&&state.mode==="emperor"){
    // Hidden placement: picks stay off the board until revealEmperors().
    state.phase="setup";
    state.picks={white:null,black:null};
  }else MODES[state.mode].setup(state);
  return state;
}

function cloneState(s){
  return{...s,
    fields:s.fields.map(f=>({size:f.size,rotation:f.rotation,
      grid:f.grid.map(row=>row.map(p=>p?{...p}:null))})),
    marshalUsed:{...s.marshalUsed},turns:{...s.turns},points:{...s.points},
    picks:s.picks?{...s.picks}:null};
}

/* ---------- geometry ---------- */

const TOPO={};
function topology(layoutName){
  if(TOPO[layoutName])return TOPO[layoutName];
  const map=new Map();
  LAYOUTS[layoutName].positions.forEach((p,f)=>{
    for(let r=0;r<SIZES[f];r++)for(let c=0;c<SIZES[f];c++)
      map.set(`${p.x+c}:${p.y+r}`,{f,r,c});
  });
  return TOPO[layoutName]=map;
}
const globalPos=(state,sq)=>{const p=LAYOUTS[state.layoutName].positions[sq.f];return{x:p.x+sq.c,y:p.y+sq.r}};
const squareAt=(state,x,y)=>topology(state.layoutName).get(`${x}:${y}`)||null;
function step(state,sq,dy,dx){const p=globalPos(state,sq);return squareAt(state,p.x+dx,p.y+dy)}

/* ---------- piece access ---------- */

const rawAt=(state,sq)=>state.fields[sq.f].grid[sq.r][sq.c];
function at(state,sq){const p=rawAt(state,sq);return p&&!p.removing?p:null}

function eachPiece(state,fn){
  state.fields.forEach((field,f)=>field.grid.forEach((row,r)=>
    row.forEach((p,c)=>{if(p&&!p.removing)fn(p,f,r,c)})));
}
function countPieces(state,color,kind=null){
  let n=0;
  eachPiece(state,p=>{if(p.color===color&&(!kind||p.kind===kind))n++});
  return n;
}
function countField(state,color,f,kind=null){
  let n=0;
  state.fields[f].grid.forEach(row=>row.forEach(p=>{
    if(p&&!p.removing&&p.color===color&&(!kind||p.kind===kind))n++;
  }));
  return n;
}
const hasMarshal=(state,f,color)=>countField(state,color,f,"marshal")>0;
function findPieces(state,color,kind){
  const out=[];
  eachPiece(state,(p,f,r,c)=>{if(p.color===color&&p.kind===kind)out.push({f,r,c})});
  return out;
}

/* ---------- flanking ---------- */

// Enemy runs that a piece of `color`/`kind` standing on `sq` would bracket.
// `sq` may be empty (hypothetical placement). Pure lookup, changes nothing.
function linesFrom(state,sq,color){
  const lines=[];
  for(const[dy,dx] of ORTHO){
    const run=[];
    let next=step(state,sq,dy,dx);
    while(next){
      const p=at(state,next);
      if(!p)break;
      if(p.color===color){
        if(run.length)lines.push({run,end:next});
        break;
      }
      run.push(next);
      next=step(state,next,dy,dx);
    }
  }
  return lines;
}

// Squares captured by `move` (already applied to `state`). Captures are tied to
// the piece that just acted: placed piece, moved Marshal, or any flank that
// touches a rotated field.
function capturesForMove(state,move,color){
  const out=new Map();
  const add=lines=>lines.forEach(l=>l.run.forEach(s=>out.set(keyOf(s),s)));
  if(move.type==="place"){
    const sq={f:move.f,r:move.r,c:move.c};
    add(linesFrom(state,sq,color));
  }else if(move.type==="marshalMove"){
    add(linesFrom(state,move.to,color));
  }else if(move.type==="rotate"){
    eachPiece(state,(p,f,r,c)=>{
      if(p.color!==color)return;
      linesFrom(state,{f,r,c},color).forEach(line=>{
        const touches=f===move.f||line.end.f===move.f||line.run.some(s=>s.f===move.f);
        if(touches)line.run.forEach(s=>out.set(keyOf(s),s));
      });
    });
  }
  return[...out.values()];
}

/* ---------- legality ---------- */

function canPlace(state,kind,f,r,c,color=state.turn){
  if(!inside(f,r,c))return false;
  const sq={f,r,c};
  if(at(state,sq))return false;
  if(kind==="squire"){
    return ORTHO.some(([dy,dx])=>{
      const n=step(state,sq,dy,dx);
      return n&&at(state,n)?.color===color;
    });
  }
  if(kind==="knight")return linesFrom(state,sq,color).length>0;
  if(kind==="marshal")return !state.marshalUsed[color]&&countField(state,color,f,"squire")>=MARSHAL_MIN_SQUIRES;
  return false;
}

function marshalTargets(state,from,color){
  const out=[];
  for(let dr=-MARSHAL_RANGE;dr<=MARSHAL_RANGE;dr++){
    for(let dc=-MARSHAL_RANGE;dc<=MARSHAL_RANGE;dc++){
      if(!dr&&!dc)continue;
      const r=from.r+dr,c=from.c+dc;
      if(!inside(from.f,r,c))continue;
      const sq={f:from.f,r,c},p=at(state,sq);
      if(!p||p.color!==color)out.push(sq);
    }
  }
  return out;
}

// A rotation must not carry an Emperor onto a square that can't be captured (see hasFlankAxis).
function rotationKeepsEmperorsSafe(state,f,dir){
  if(!EMPEROR_CAPTURABLE_ONLY)return true;
  const n=SIZES[f];
  for(let r=0;r<n;r++)for(let c=0;c<n;c++){
    const p=state.fields[f].grid[r][c];
    if(p&&!p.removing&&p.kind==="emperor"){
      const to=dir===1?{r:c,c:n-1-r}:{r:n-1-c,c:r};
      if(!hasFlankAxis(state,{f,r:to.r,c:to.c}))return false;
    }
  }
  return true;
}

// dir 1 = right, -1 = left; omit dir to ask "can this field be rotated either way?"
function canRotate(state,f,color,dir){
  const allowed=countField(state,color,f,"squire")>0&&
    !(MODES[state.mode].marshalLocksRotation!==false&&hasMarshal(state,f,other(color)));
  if(!allowed)return false;
  if(dir===undefined)return rotationKeepsEmperorsSafe(state,f,1)||rotationKeepsEmperorsSafe(state,f,-1);
  return rotationKeepsEmperorsSafe(state,f,dir);
}

function legalMoves(state,color=state.turn){
  const moves=[];
  state.fields.forEach((field,f)=>field.grid.forEach((row,r)=>row.forEach((_,c)=>{
    if(at(state,{f,r,c}))return;
    for(const kind of KINDS)if(canPlace(state,kind,f,r,c,color))moves.push({type:"place",kind,f,r,c});
  })));
  findPieces(state,color,"marshal").forEach(from=>
    marshalTargets(state,from,color).forEach(to=>moves.push({type:"marshalMove",from,to})));
  SIZES.forEach((_,f)=>{
    for(const dir of[1,-1])if(canRotate(state,f,color,dir))moves.push({type:"rotate",f,dir});
  });
  return moves;
}

// Early-exit version used for the "no legal move" loss check.
function hasLegalMove(state,color){
  if(SIZES.some((_,f)=>canRotate(state,f,color)))return true;
  if(findPieces(state,color,"marshal").some(m=>marshalTargets(state,m,color).length))return true;
  for(let f=0;f<SIZES.length;f++)for(let r=0;r<SIZES[f];r++)for(let c=0;c<SIZES[f];c++){
    if(at(state,{f,r,c}))continue;
    for(const kind of KINDS)if(canPlace(state,kind,f,r,c,color))return true;
  }
  return false;
}

/* ---------- rotation ---------- */

function rotateField(state,f,dir){
  const old=state.fields[f].grid,n=old.length;
  state.fields[f].grid=Array.from({length:n},(_,r)=>
    Array.from({length:n},(_,c)=>dir===1?old[n-1-c][r]:old[c][n-1-r]));
  state.fields[f].rotation=(state.fields[f].rotation+dir*90+360)%360;
}

/* ---------- scoring ---------- */

// Half the squares plus one: 3×3 -> 5, 5×5 -> 13, 7×7 -> 25 (used by Plurality).
const fieldThreshold=f=>Math.floor(SIZES[f]*SIZES[f]/2)+1;

// Weighted presence on a field (weights come from the mode; Hill: 1/1/2, Plurality: 1/2/3).
function fieldInfluence(state,f){
  const w=MODES[state.mode].weights||INFLUENCE;
  const total={white:0,black:0};
  state.fields[f].grid.forEach(row=>row.forEach(p=>{
    if(p&&!p.removing)total[p.color]+=w[p.kind];
  }));
  return total;
}
function fieldOwner(state,f){
  const i=fieldInfluence(state,f);
  if(MODES[state.mode].boardMajority){            // Plurality: need half the board AND more than the opponent
    const need=fieldThreshold(f);
    if(i.white>=need&&i.white>i.black)return"white";
    if(i.black>=need&&i.black>i.white)return"black";
    return null;
  }
  if(i.white===i.black)return null;
  return i.white>i.black?"white":"black";
}
const fieldPoints=(state,color)=>
  SIZES.reduce((sum,_,f)=>sum+(fieldOwner(state,f)===color?FIELD_VALUE[f]:0),0);

const startTurnOf=(state,color)=>(MODES[state.mode].startTurn||START_TURN)[color];

function score(state){
  const out={};
  for(const color of["white","black"]){
    out[color]={fields:fieldPoints(state,color),total:state.points[color],
      turns:state.turns[color],scoring:state.turns[color]>=startTurnOf(state,color)};
  }
  return out;
}

function accrue(state,color){
  state.turns[color]++;
  if(state.turns[color]>=startTurnOf(state,color))state.points[color]+=fieldPoints(state,color);
}

function finish(state,winner,reason){
  state.over=true;state.winner=winner;state.endReason=reason;
}

// Checked after Black's turn so both sides always get equal turns.
function checkRoundEnd(state){
  const w=state.points.white,b=state.points.black,t=state.target;
  if(w<t&&b<t)return;
  if(w!==b){
    const winner=w>b?"white":"black";
    finish(state,winner,`${cap(winner)} reached ${Math.max(w,b)} points.`);
    return;
  }
  const mode=MODES[state.mode];
  const tb=mode.tieBreak?mode.tieBreak(state):{winner:fieldOwner(state,BIG_FIELD),why:"holding the 7×7"};
  if(tb.winner)finish(state,tb.winner,`Tied at ${w}. ${cap(tb.winner)} wins the tiebreaker by ${tb.why}.`);
}

/* ---------- Emperor mode setup (hidden Emperor placement) ---------- */

const homeField=color=>color==="white"?0:4;

// A square can be flanked only if some axis has a square on BOTH sides of it.
// (Board-edge corners can't be flanked, so a piece there can never be captured by a bracket.)
function isFlankable(state,sq){
  return[[[1,0],[-1,0]],[[0,1],[0,-1]]].some(axis=>axis.every(([dy,dx])=>!!step(state,sq,dy,dx)));
}

// An Emperor needs a flank axis whose two squares both exist AND can themselves be flanked.
// Otherwise a defender could fill a neighbouring corner with a piece that can never be
// captured, and the Emperor could never be bracketed (a permanent lock).
function hasFlankAxis(state,sq){
  return[[[1,0],[-1,0]],[[0,1],[0,-1]]].some(axis=>axis.every(([dy,dx])=>{
    const n=step(state,sq,dy,dx);
    return !!n&&isFlankable(state,n);
  }));
}

// Each side may place its Emperor in its own 3×3 or its own 5×5; the 7×7 is off limits.
const emperorFields=color=>color==="white"?[0,1]:[4,3];

function canPlaceEmperor(state,color,sq){
  return state.phase==="setup"&&emperorFields(color).includes(sq.f)&&inside(sq.f,sq.r,sq.c)&&!rawAt(state,sq)&&
    (!EMPEROR_CAPTURABLE_ONLY||hasFlankAxis(state,sq));
}

// Put both chosen Emperors on the board and start play.
function revealEmperors(state){
  for(const color of["white","black"]){
    let sq=state.picks&&state.picks[color];
    if(!sq||!canPlaceEmperor(state,color,sq))sq={f:homeField(color),...EMPEROR_START};
    state.fields[sq.f].grid[sq.r][sq.c]={color,kind:"emperor"};
  }
  state.phase="play";
}

// Computer's secret pick: uses only its own side of the board, never the opponent's pick.
function chooseEmperorSquare(state,color,level="normal"){
  const options=[];
  for(const f of emperorFields(color))
    state.fields[f].grid.forEach((row,r)=>row.forEach((p,c)=>{
      if(canPlaceEmperor(state,color,{f,r,c}))options.push({f,r,c});
    }));
  if(level==="easy"||level==="dummy")return options[Math.floor(Math.random()*options.length)];
  let best=null,bestScore=-Infinity;
  for(const sq of options){
    let v=Math.random()*.5+(sq.f===homeField(color)?.8:0);     // the 3×3 is the safer, further-back choice
    for(const[dy,dx] of ORTHO){
      const n=step(state,sq,dy,dx);
      if(!n)v+=1.2;                              // board edge: no flank possible on that axis
      else{const q=at(state,n);if(q&&q.color===color)v+=1}
    }
    if(v>bestScore){bestScore=v;best=sq}
  }
  return best;
}

/* ---------- repetition ---------- */

// Same pieces + same side to move (+ same score in Hill mode) = same position.
function positionKey(state){
  const grid=state.fields.map(f=>f.grid.map(row=>
    row.map(p=>p&&!p.removing?p.color[0]+p.kind[0]:".").join("")).join("/")).join("|");
  const pts=MODES[state.mode].usesPoints?`${state.points.white},${state.points.black}`:"";
  return`${state.turn}|${pts}|${state.marshalUsed.white?1:0}${state.marshalUsed.black?1:0}|${grid}`;
}
function declareDraw(state,reason){
  state.over=true;state.winner=null;state.endReason=reason;
}

/* ---------- applying a move ---------- */

// Mutates `state`. Captured pieces are flagged `removing` (already excluded
// from influence and legality) and stay on the grid until settle().
function applyMove(state,move){
  const color=state.turn,foe=other(color);
  const result={color,move,captured:[],landed:null,gained:0,touched:[]};
  const lost=[];                 // kinds of pieces captured by this move

  if(move.type==="place"){
    const sq={f:move.f,r:move.r,c:move.c};
    state.fields[sq.f].grid[sq.r][sq.c]={color,kind:move.kind};
    if(move.kind==="marshal")state.marshalUsed[color]=true;
    result.touched=[keyOf(sq)];
  }else if(move.type==="marshalMove"){
    const moving=at(state,move.from),victim=at(state,move.to);
    state.fields[move.from.f].grid[move.from.r][move.from.c]=null;
    state.fields[move.to.f].grid[move.to.r][move.to.c]=moving;
    if(victim){result.landed=keyOf(move.to);lost.push(victim.kind)}
    result.touched=[keyOf(move.from),keyOf(move.to)];
  }else if(move.type==="rotate"){
    rotateField(state,move.f,move.dir);
  }

  capturesForMove(state,move,color).forEach(sq=>{
    const p=rawAt(state,sq);
    if(p&&!p.removing){p.removing=true;result.captured.push(keyOf(sq));lost.push(p.kind)}
  });

  const mode=MODES[state.mode];
  mode.afterCaptures(state,color,lost);

  if(!state.over&&mode.squireLoss!==false&&countPieces(state,foe,"squire")===0)
    finish(state,color,`${cap(foe)} has no Squires left.`);

  if(!state.over)mode.endTurn(state,color,result);

  state.turn=foe;
  state.ply++;
  if(!state.over&&!hasLegalMove(state,foe))
    finish(state,color,`${cap(foe)} has no legal move.`);
  return result;
}

// Remove pieces flagged by captures.
function settle(state){
  state.fields.forEach(field=>field.grid.forEach(row=>row.forEach((p,c)=>{
    if(p&&p.removing)row[c]=null;
  })));
}

/* ---------- AI ---------- */

function placementMobility(state,color){
  let total=0;
  state.fields.forEach((field,f)=>field.grid.forEach((row,r)=>row.forEach((_,c)=>{
    const sq={f,r,c};
    if(at(state,sq))return;
    if(ORTHO.some(([dy,dx])=>{const n=step(state,sq,dy,dx);return n&&at(state,n)?.color===color}))total++;
  })));
  return Math.min(total,30);
}

// Value of enemy pieces `color` could capture right now by dropping a Knight.
function captureThreat(state,color){
  let threat=0;
  state.fields.forEach((field,f)=>field.grid.forEach((row,r)=>row.forEach((_,c)=>{
    const sq={f,r,c};
    if(at(state,sq))return;
    linesFrom(state,sq,color).forEach(line=>
      line.run.forEach(s=>{threat+=PIECE_VALUE[at(state,s).kind]}));
  })));
  return Math.min(threat,20);
}

// Positive = good for `me`.
function evaluate(state,me="black"){return MODES[state.mode].evaluate(state,me)}

function evaluateHill(state,me="black"){
  const foe=other(me);
  if(state.winner)return state.winner===me?10000:-10000;
  let material=0;
  eachPiece(state,p=>{material+=(p.color===me?1:-1)*STRATEGIC_VALUE[p.kind]});
  const rate=fieldPoints(state,me)-fieldPoints(state,foe);
  const bank=state.points[me]-state.points[foe];
  const big=fieldOwner(state,BIG_FIELD);
  const bigBonus=big===me?1.5:big===foe?-1.5:0;
  const mobility=placementMobility(state,me)-placementMobility(state,foe);
  const threats=captureThreat(state,me)-captureThreat(state,foe);
  const danger=n=>n>=4?0:(4-n)*(4-n)*.5;      // few Squires left = near elimination
  const safety=danger(countPieces(state,foe,"squire"))-danger(countPieces(state,me,"squire"));
  return material*.5+rate*1.6+bank+bigBonus+mobility*.055+threats*.16+safety;
}

// Emperor mode: how hard `attacker` is leaning on the enemy Emperor.
// An enemy piece orthogonally beside the Emperor with the opposite square open is a
// one-move threat (a Knight dropped opposite captures it).
function emperorPressure(state,attacker){
  const foe=other(attacker),E=findPieces(state,foe,"emperor")[0];
  if(!E)return 0;
  let pressure=0;
  for(const axis of[[[1,0],[-1,0]],[[0,1],[0,-1]]]){
    const sides=axis.map(([dy,dx])=>{const n=step(state,E,dy,dx);return n?at(state,n):undefined});
    if(sides.includes(undefined))continue;                      // board edge: can't be flanked on this axis
    const mine=sides.filter(x=>x&&x.color===attacker).length;
    const open=sides.filter(x=>x===null).length;
    if(mine===1&&open===1)pressure+=4;else if(mine===1)pressure+=1;
  }
  const g=globalPos(state,E);let near=0;
  eachPiece(state,(p,f,r,c)=>{
    if(p.color!==attacker)return;
    const q=globalPos(state,{f,r,c});
    if(Math.max(Math.abs(q.x-g.x),Math.abs(q.y-g.y))<=2)near++;
  });
  return pressure+Math.min(near,8)*.3;
}

// Plurality: like Hill, plus credit for progress toward each field's half-the-board threshold.
function evaluatePlurality(state,me="black"){
  const foe=other(me);
  if(state.winner)return state.winner===me?10000:-10000;
  let material=0;
  eachPiece(state,p=>{material+=(p.color===me?1:-1)*STRATEGIC_VALUE[p.kind]});
  const rate=fieldPoints(state,me)-fieldPoints(state,foe);
  const bank=state.points[me]-state.points[foe];
  let progress=0;
  for(let f=0;f<SIZES.length;f++){
    const i=fieldInfluence(state,f),need=fieldThreshold(f);
    progress+=FIELD_VALUE[f]*(Math.min(i[me],need)-Math.min(i[foe],need))/need;
  }
  const big=fieldOwner(state,BIG_FIELD);
  const bigBonus=big===me?1.5:big===foe?-1.5:0;
  const mobility=placementMobility(state,me)-placementMobility(state,foe);
  const threats=captureThreat(state,me)-captureThreat(state,foe);
  const danger=n=>n>=4?0:(4-n)*(4-n)*.5;
  const safety=danger(countPieces(state,foe,"squire"))-danger(countPieces(state,me,"squire"));
  return material*.3+rate*1.6+bank+progress*2.5+bigBonus+mobility*.04+threats*.14+safety;
}

// Chebyshev distance from `attacker`'s nearest non-Emperor piece to the enemy Emperor.
function nearestToEmperor(state,attacker){
  const E=findPieces(state,other(attacker),"emperor")[0];
  if(!E)return 0;
  const g=globalPos(state,E);let best=99;
  eachPiece(state,(p,f,r,c)=>{
    if(p.color!==attacker||p.kind==="emperor")return;
    const q=globalPos(state,{f,r,c});
    best=Math.min(best,Math.max(Math.abs(q.x-g.x),Math.abs(q.y-g.y)));
  });
  return best;
}

function evaluateEmperor(state,me="black"){
  const foe=other(me);
  if(state.winner)return state.winner===me?10000:-10000;
  let material=0;
  eachPiece(state,p=>{material+=(p.color===me?1:-1)*STRATEGIC_VALUE[p.kind]});
  const pressure=emperorPressure(state,me)-emperorPressure(state,foe);
  const approach=nearestToEmperor(state,foe)-nearestToEmperor(state,me);   // closer to their Emperor is better
  const mobility=placementMobility(state,me)-placementMobility(state,foe);
  const threats=captureThreat(state,me)-captureThreat(state,foe);
  return material*.25+pressure*1.5+approach*1.2+mobility*.02+threats*.12;
}

const AI_TUNING={passPenalty:6};     // Emperor mode: cost of a rotation that captures nothing

function pickNear(scored,margin){
  const top=scored[0].value;
  const pool=scored.filter(s=>s.value>=top-margin);
  return pool[Math.floor(Math.random()*pool.length)].move;
}

// Every legal move applied to a copy and scored 1-ply, best first.
function scoreMoves(state,color,moves){
  const scored=moves.map(move=>{
    const next=cloneState(state);
    const res=applyMove(next,move);
    settle(next);
    let value=evaluate(next,color);
    // Emperor mode has no points, so a rotation that captures nothing is just a free pass: discourage it.
    if(state.mode==="emperor"&&move.type==="rotate"&&!res.captured.length)value-=AI_TUNING.passPenalty;
    if(move.type==="place"&&move.kind==="marshal"&&state.ply<8)value-=1;
    return{move,next,value};
  });
  scored.sort((a,b)=>b.value-a.value);
  return scored;
}

// Negamax with alpha-beta and a narrow beam. Scores are from `toMove`'s point of view.
const OPT={depth:3,rootBeam:10,beam:6,budgetMs:1800,repeatPenalty:2.5};
function negamax(state,toMove,depth,alpha,beta,deadline){
  const moves=legalMoves(state,toMove);
  if(!moves.length)return evaluate(state,toMove);
  const kids=moves.map(move=>{
    const n=cloneState(state);applyMove(n,move);settle(n);
    return{n,v:evaluate(n,toMove)};
  });
  if(depth<=1)return Math.max(...kids.map(k=>k.v));
  kids.sort((a,b)=>b.v-a.v);
  let best=-Infinity;
  for(const k of kids.slice(0,OPT.beam)){
    const v=k.n.over?k.v:-negamax(k.n,other(toMove),depth-1,-beta,-alpha,deadline);
    if(v>best)best=v;
    if(best>alpha)alpha=best;
    if(alpha>=beta||Date.now()>deadline)break;
  }
  return best;
}

function chooseOptimized(state,color,scored,seen){
  const deadline=Date.now()+OPT.budgetMs;
  let best=null,bestValue=-Infinity;
  for(const cand of scored.slice(0,OPT.rootBeam)){
    let v;
    if(cand.next.over)v=cand.value;
    else v=-negamax(cand.next,other(color),OPT.depth-1,-Infinity,Infinity,deadline);
    // Avoid walking into a repeated position (draw by repetition) unless nothing else is better.
    if(seen)v-=OPT.repeatPenalty*(seen.get(positionKey(cand.next))||0);
    v+=Math.random()*.02;
    if(v>bestValue){bestValue=v;best=cand.move}
    if(best&&Date.now()>deadline)break;
  }
  return best||scored[0].move;
}

// level "dummy": random legal move (testing).
// level "easy": best 1-ply move (random among near-ties).
// level "normal": 2-ply, checks the opponent's best reply for the top candidates.
// level "optimized": 3-ply alpha-beta with a time budget; avoids repeating positions.
// `seen` = Map of positionKey -> times seen (optional).
function chooseAI(state,level="normal",color=state.turn,seen=null){
  const moves=legalMoves(state,color);
  if(!moves.length)return null;
  if(level==="dummy")return moves[Math.floor(Math.random()*moves.length)];
  const scored=scoreMoves(state,color,moves);
  if(level==="easy")return pickNear(scored,.12);
  if(level==="optimized")return chooseOptimized(state,color,scored,seen);

  const candidates=scored.slice(0,8);
  candidates.forEach(cand=>{
    if(cand.next.over)return;
    let worst=Infinity;
    for(const reply of legalMoves(cand.next,other(color))){
      const after=cloneState(cand.next);
      applyMove(after,reply);
      settle(after);
      worst=Math.min(worst,evaluate(after,color));
    }
    if(worst<Infinity)cand.value=worst*.8+cand.value*.2;
  });
  candidates.sort((a,b)=>b.value-a.value);
  return pickNear(candidates,.05);
}

/* ---------- rule tests ---------- */

function runRuleTests(){
  const results=[];
  const check=(name,ok)=>results.push(`${ok?"PASS":"FAIL"} — ${name}`);
  const blank=(layoutName="straight",target=DEFAULT_TARGET)=>newState({layoutName,target});
  const put=(s,f,r,c,color,kind)=>{s.fields[f].grid[r][c]={color,kind}};
  const putG=(s,x,y,color,kind)=>{const sq=squareAt(s,x,y);put(s,sq.f,sq.r,sq.c,color,kind);return sq};
  const W="white",B="black";
  const hasLegalMoveOfType=(st,color,kind)=>legalMoves(st,color).some(m=>m.type===kind||m.type==="place"&&m.kind===kind);

  // ----- layouts -----
  for(const name of Object.keys(LAYOUTS)){
    const pos=LAYOUTS[name].positions;
    const W_=Math.max(...pos.map((p,i)=>p.x+SIZES[i])),H_=Math.max(...pos.map((p,i)=>p.y+SIZES[i]));
    check(`${name}: layout is 180° point-symmetric`,
      pos.every((p,i)=>{const q=pos[4-i];return q.x===W_-p.x-SIZES[i]&&q.y===H_-p.y-SIZES[i]}));

    const s=createGame({layoutName:name});
    const cells=new Set();let overlap=false;
    s.fields.forEach((_,f)=>{for(let r=0;r<SIZES[f];r++)for(let c=0;c<SIZES[f];c++){
      const g=globalPos(s,{f,r,c}),k=`${g.x}:${g.y}`;if(cells.has(k))overlap=true;cells.add(k)}});
    check(`${name}: fields do not overlap`,!overlap);

    const touches=(a,b)=>{
      for(let r=0;r<SIZES[a];r++)for(let c=0;c<SIZES[a];c++)
        for(const[dy,dx] of ORTHO){const n=step(s,{f:a,r,c},dy,dx);if(n&&n.f===b)return true}
      return false};
    check(`${name}: neighbouring fields in the chain touch`,
      [[0,1],[1,2],[2,3],[3,4]].every(([a,b])=>touches(a,b)));
    check(`${name}: homes touch the 7×7 only in the block layout`,
      (touches(0,2)&&touches(4,2))===(name==="block")&&(touches(0,2)===touches(4,2)));

    // starting roads are point-symmetric and equidistant from the 7x7
    const roadW=findPieces(s,W,"squire").map(q=>globalPos(s,q)),roadB=findPieces(s,B,"squire").map(q=>globalPos(s,q));
    const mirrored=roadW.map(g=>`${W_-1-g.x}:${H_-1-g.y}`).sort().join("|");
    check(`${name}: starting roads mirror each other`,mirrored===roadB.map(g=>`${g.x}:${g.y}`).sort().join("|"));

    const dist=(color)=>{
      let frontier=findPieces(s,color,"squire");
      const seen=new Set(frontier.map(keyOf));
      let d=0;
      while(frontier.length){
        if(frontier.some(q=>q.f===BIG_FIELD))return d;
        const nxt=[];
        frontier.forEach(q=>ORTHO.forEach(([dy,dx])=>{const n=step(s,q,dy,dx);
          if(n&&!seen.has(keyOf(n))){seen.add(keyOf(n));nxt.push(n)}}));
        frontier=nxt;d++;
      }
      return -1;};
    check(`${name}: both homes are the same distance from the 7×7`,dist(W)===dist(B));
  }
  check("Field values are 1/2/3/2/1",FIELD_VALUE.join()==="1,2,3,2,1");
  check("Default target is 100",DEFAULT_TARGET===100&&newState().target===100);

  // ----- Squires -----
  let s=blank();
  put(s,2,3,3,W,"marshal");
  check("Squire may be placed orthogonally beside a Marshal",canPlace(s,"squire",2,3,4,W));
  check("Squire may not be placed diagonally only",!canPlace(s,"squire",2,4,4,W));

  // ----- Knights -----
  s=blank();put(s,2,3,0,W,"squire");put(s,2,3,4,W,"squire");
  check("Knight cannot be placed without a capture",!canPlace(s,"knight",2,3,5,W)&&!canPlace(s,"knight",2,2,0,W));

  s=blank();put(s,2,3,0,W,"squire");put(s,2,3,1,B,"squire");
  check("Knight can be placed to flank against a Squire",canPlace(s,"knight",2,3,2,W));
  let r=applyMove(s,{type:"place",kind:"knight",f:2,r:3,c:2});
  check("Knight placement captures the flanked piece",r.captured.length===1&&s.fields[2].grid[3][1].removing===true);

  s=blank();put(s,2,3,0,W,"knight");put(s,2,3,1,B,"squire");
  check("Knight can flank together with another Knight",canPlace(s,"knight",2,3,2,W));
  r=applyMove(s,{type:"place",kind:"knight",f:2,r:3,c:2});
  check("Knight–Knight flank captures",r.captured.length===1);
  s=blank();put(s,2,3,0,W,"marshal");put(s,2,3,1,B,"squire");
  check("Knight can flank together with a Marshal",canPlace(s,"knight",2,3,2,W));

  s=blank();put(s,2,3,0,W,"knight");put(s,2,3,1,B,"squire");put(s,2,2,2,W,"squire");
  r=applyMove(s,{type:"place",kind:"squire",f:2,r:3,c:2});
  check("A placed Knight still anchors a Squire's flank",r.captured.length===1);

  s=blank();putG(s,7,3,W,"squire");putG(s,8,3,B,"squire");putG(s,9,3,B,"knight");
  const sq=squareAt(s,10,3);
  check("Knight flank works across a field seam",canPlace(s,"knight",sq.f,sq.r,sq.c,W));
  r=applyMove(s,{type:"place",kind:"knight",f:sq.f,r:sq.r,c:sq.c});
  check("Seam flank captures the whole run",r.captured.length===2);

  // ----- Marshal -----
  s=blank();put(s,2,3,0,W,"marshal");put(s,2,3,1,B,"squire");put(s,2,2,2,W,"squire");
  r=applyMove(s,{type:"place",kind:"squire",f:2,r:3,c:2});
  check("Marshal acts as a flank anchor",r.captured.length===1);

  s=blank();put(s,2,4,1,W,"marshal");put(s,2,3,2,B,"squire");put(s,2,3,3,W,"squire");
  r=applyMove(s,{type:"marshalMove",from:{f:2,r:4,c:1},to:{f:2,r:3,c:1}});
  check("Marshal moving into position flanks",r.captured.length===1);

  s=blank();put(s,2,3,3,W,"marshal");put(s,2,3,4,B,"squire");put(s,2,2,3,W,"squire");
  const targets=marshalTargets(s,{f:2,r:3,c:3},W);
  check("Marshal moves within its 3×3 (8 squares minus friendly)",targets.length===7);
  check("Marshal cannot move 2 squares",!targets.some(t=>t.c===5||t.c===1||t.r===5||t.r===1));
  r=applyMove(s,{type:"marshalMove",from:{f:2,r:3,c:3},to:{f:2,r:3,c:4}});
  check("Marshal captures an enemy by moving onto it",r.landed&&s.fields[2].grid[3][4].kind==="marshal");
  s=blank();put(s,2,0,0,W,"marshal");
  check("Marshal in a corner has 3 moves",marshalTargets(s,{f:2,r:0,c:0},W).length===3);

  s=blank();put(s,2,0,0,W,"squire");put(s,2,0,1,W,"squire");
  check("Marshal needs three Squires on the field",!canPlace(s,"marshal",2,5,5,W));
  put(s,2,0,2,W,"squire");
  check("Marshal deploys on any empty square of a field with 3 Squires",canPlace(s,"marshal",2,5,5,W));
  check("Marshal cannot be placed on an occupied square",!canPlace(s,"marshal",2,0,0,W));
  s.marshalUsed.white=true;
  check("Only one Marshal per game",!canPlace(s,"marshal",2,5,5,W));

  // ----- Safe entry -----
  s=blank();put(s,2,3,1,B,"squire");put(s,2,3,3,B,"squire");put(s,2,2,2,W,"squire");
  applyMove(s,{type:"place",kind:"squire",f:2,r:3,c:2});   // White steps between two Black pieces
  applyMove(s,{type:"place",kind:"squire",f:2,r:4,c:3});   // Black plays an unrelated move
  check("A piece placed into a sandwich is not captured by an unrelated move",
    s.fields[2].grid[3][2]&&!s.fields[2].grid[3][2].removing);

  // ----- Rotation -----
  s=blank();put(s,0,0,0,W,"squire");rotateField(s,0,1);
  check("Rotate right is clockwise (top-left goes to top-right)",!!s.fields[0].grid[0][2]);
  rotateField(s,0,-1);
  check("Rotate left undoes rotate right",!!s.fields[0].grid[0][0]);

  s=blank();putG(s,7,3,W,"squire");
  put(s,2,6,3,B,"squire");put(s,2,5,3,B,"squire");put(s,2,4,3,W,"squire");
  r=applyMove(s,{type:"rotate",f:2,dir:1});
  check("Rotating a field can capture (rotated into a flank across the seam)",r.captured.length===2);

  s=blank();put(s,2,4,3,W,"squire");put(s,2,6,3,B,"squire");
  r=applyMove(s,{type:"rotate",f:2,dir:1});
  check("Rotation without a flank captures nothing",r.captured.length===0);

  s=blank();put(s,2,3,3,W,"squire");put(s,2,3,2,B,"squire");put(s,2,3,4,B,"squire");
  s.turn=B;
  put(s,2,0,0,B,"squire");
  check("Rotation needs a Squire on the field",!canRotate(s,1,W)&&canRotate(s,2,W));
  put(s,2,1,1,B,"marshal");
  check("Enemy Marshal blocks rotation",!canRotate(s,2,W)&&canRotate(s,2,B));

  // ----- Scoring -----
  s=blank();put(s,1,0,0,W,"squire");put(s,2,0,0,W,"squire");
  check("White holding the 5×5 and 7×7 earns 2+3 per turn",fieldPoints(s,W)===5);
  put(s,2,0,1,B,"marshal");
  check("Marshal counts as two influence (flips the 7×7)",fieldOwner(s,2)===B&&fieldPoints(s,W)===2);

  s=blank();put(s,2,3,3,W,"squire");put(s,4,0,0,B,"squire");s.turns.white=2;
  applyMove(s,{type:"place",kind:"squire",f:2,r:3,c:2});
  check("White banks nothing on its turn 3",s.points.white===0);
  s.turn=W;applyMove(s,{type:"place",kind:"squire",f:2,r:3,c:4});
  check("White banks the 7×7 value (3) on its turn 4",s.points.white===3);

  s=blank();put(s,0,0,0,B,"squire");put(s,2,6,6,W,"squire");s.turns.black=1;s.turn=B;
  applyMove(s,{type:"place",kind:"squire",f:0,r:1,c:0});
  check("Black banks nothing on its turn 2",s.points.black===0);
  s.turn=B;applyMove(s,{type:"place",kind:"squire",f:0,r:2,c:0});
  check("Black banks the 3×3 value (1) on its turn 3",s.points.black===1);

  s=blank("straight",51);put(s,2,3,3,W,"squire");put(s,0,0,0,B,"squire");put(s,4,0,0,B,"squire");
  s.points.white=51;s.points.black=47;s.turns.black=2;s.turn=B;
  applyMove(s,{type:"place",kind:"squire",f:0,r:1,c:0});   // +1 (3x3). 4x? black holds 3x3s: 1+1 = 2
  check("Target reached: higher total wins at the end of the round",s.over&&s.winner===W);

  s=blank("straight",51);put(s,2,3,3,W,"squire");put(s,0,0,0,B,"squire");put(s,4,0,0,B,"squire");
  s.points.white=51;s.points.black=49;s.turns.black=2;s.turn=B;
  applyMove(s,{type:"place",kind:"squire",f:0,r:1,c:0});   // Black banks 2 -> tie at 51
  check("Tie at the target goes to the 7×7 holder",s.over&&s.winner===W&&s.points.black===51);

  s=blank("straight",75);put(s,2,3,3,W,"squire");put(s,0,0,0,B,"squire");
  s.points.white=51;s.points.black=50;s.turns.black=2;s.turn=B;
  applyMove(s,{type:"place",kind:"squire",f:0,r:1,c:0});
  check("At a 75 target, 51 points does not end the game",!s.over);

  // ----- Elimination -----
  s=blank();put(s,2,3,1,W,"squire");put(s,2,3,0,B,"squire");put(s,2,2,2,B,"squire");s.turn=B;
  r=applyMove(s,{type:"place",kind:"squire",f:2,r:3,c:2});
  check("Capturing a player's last Squire wins immediately",s.over&&s.winner===B&&/no Squires/.test(s.endReason));

  s=blank();put(s,2,3,1,W,"squire");put(s,2,3,0,B,"marshal");put(s,2,2,2,B,"squire");s.turn=B;
  put(s,2,5,5,B,"squire");
  applyMove(s,{type:"marshalMove",from:{f:2,r:3,c:0},to:{f:2,r:3,c:1}});
  check("Marshal landing on a last Squire wins immediately",s.over&&s.winner===B);

  // ----- Emperor -----
  const emperorGame=(layoutName="straight")=>createGame({layoutName,mode:"emperor"});
  const emperorBlank=()=>newState({mode:"emperor"});
  for(const name of Object.keys(LAYOUTS)){
    const g=emperorGame(name);
    check(`${name}: Emperor mode places one Emperor per side at the home centre`,
      findPieces(g,W,"emperor").length===1&&findPieces(g,B,"emperor").length===1&&
      g.fields[0].grid[1][1].kind==="emperor"&&g.fields[4].grid[1][1].kind==="emperor");
  }
  check("Hill mode has no Emperors",findPieces(createGame(),W,"emperor").length===0);
  let g=emperorGame();
  check("Emperor never appears as a legal placement or move",
    legalMoves(g,W).every(m=>m.type==="rotate"||m.type==="place"&&m.kind!=="emperor"));
  const rot=cloneState(g);rotateField(rot,0,1);
  check("Rotating the home field leaves the Emperor on its square",rot.fields[0].grid[1][1].kind==="emperor");

  s=emperorBlank();put(s,2,3,3,B,"emperor");put(s,2,3,2,W,"squire");put(s,2,2,4,W,"squire");put(s,4,0,0,B,"squire");
  put(s,2,4,3,W,"squire");put(s,2,3,4,W,"squire");
  r=applyMove(s,{type:"place",kind:"squire",f:2,r:2,c:3});
  check("Emperor mode: capturing the Emperor by flank ends the game immediately",s.over&&s.winner===W&&/Emperor/.test(s.endReason));

  s=emperorBlank();put(s,2,3,3,B,"emperor");put(s,2,3,2,W,"squire");put(s,4,0,0,B,"squire");
  check("Emperor mode: a Knight may be dropped opposite a piece beside the Emperor",canPlace(s,"knight",2,3,4,W));
  r=applyMove(s,{type:"place",kind:"knight",f:2,r:3,c:4});
  check("Emperor mode: Knight flank capturing the Emperor wins",s.over&&s.winner===W);

  s=emperorBlank();put(s,2,3,3,W,"marshal");put(s,2,3,4,B,"emperor");put(s,0,0,0,W,"squire");put(s,4,0,0,B,"squire");
  r=applyMove(s,{type:"marshalMove",from:{f:2,r:3,c:3},to:{f:2,r:3,c:4}});
  check("Emperor mode: Marshal landing on the Emperor wins",s.over&&s.winner===W);

  s=emperorBlank();put(s,2,3,0,W,"emperor");put(s,2,3,1,B,"squire");put(s,2,2,2,W,"squire");put(s,4,0,0,B,"squire");
  r=applyMove(s,{type:"place",kind:"squire",f:2,r:3,c:2});
  check("Emperor acts as a flank anchor (captures an enemy Squire)",r.captured.length===1&&!s.over);

  s=emperorGame();
  check("Emperor mode scores no points",(()=>{const c=cloneState(s);applyMove(c,legalMoves(c,W)[0]);return c.points.white===0&&c.points.black===0})());
  s=emperorBlank();put(s,0,1,1,W,"emperor");put(s,0,0,0,W,"squire");put(s,2,3,2,B,"squire");put(s,2,3,4,W,"squire");put(s,2,3,3,B,"squire");
  s.turn=B;applyMove(s,{type:"place",kind:"squire",f:2,r:4,c:3});
  check("Emperor mode: the game continues while both sides have Squires",s.over===false);
  s=emperorBlank();put(s,0,1,1,W,"emperor");put(s,2,3,1,W,"squire");put(s,2,3,0,B,"squire");put(s,2,2,2,B,"squire");
  s.turn=B;applyMove(s,{type:"place",kind:"squire",f:2,r:3,c:2});
  check("Emperor mode: losing every Squire does NOT end the game (the Emperor is the objective)",!s.over);

  // rotation lock is a per-mode switch
  s=emperorBlank();put(s,2,3,3,W,"squire");put(s,2,0,0,B,"marshal");
  const lockWas=MODES.emperor.marshalLocksRotation;
  MODES.emperor.marshalLocksRotation=true;const locked=!canRotate(s,2,W);
  MODES.emperor.marshalLocksRotation=false;const free=canRotate(s,2,W);
  MODES.emperor.marshalLocksRotation=lockWas;
  check("Marshal rotation lock can be switched per mode",locked&&free);

  // ----- Setup phase (Emperor) -----
  s=createGame({mode:"emperor",emperorSetup:true});
  check("Emperor setup starts in the setup phase with no Emperors on the board",
    s.phase==="setup"&&findPieces(s,W,"emperor").length===0&&findPieces(s,B,"emperor").length===0);
  check("Emperor may go on an empty home-field square",canPlaceEmperor(s,W,{f:0,r:1,c:1})&&canPlaceEmperor(s,B,{f:4,r:0,c:0}));
  check("Emperor cannot go on an occupied square, the other home field, or another field",
    !canPlaceEmperor(s,W,{f:0,r:0,c:0})&&!canPlaceEmperor(s,W,{f:4,r:1,c:1})&&!canPlaceEmperor(s,W,{f:2,r:3,c:3}));
  s.picks.white={f:0,r:2,c:2};s.picks.black={f:4,r:1,c:0};
  check("Picks stay off the board until revealed",findPieces(s,W,"emperor").length===0);
  revealEmperors(s);
  check("Reveal places both Emperors on their chosen squares and starts play",
    s.phase==="play"&&s.fields[0].grid[2][2].kind==="emperor"&&s.fields[4].grid[1][0].kind==="emperor");
  const carried=cloneState(s);rotateField(carried,0,1);
  check("Rotation carries a non-centre Emperor with its field",
    findPieces(carried,W,"emperor").length===1&&!(carried.fields[0].grid[2][2]&&carried.fields[0].grid[2][2].kind==="emperor"));
  check("AI Emperor pick is always a legal square",(()=>{
    const g=createGame({mode:"emperor",emperorSetup:true});
    return["easy","normal","optimized"].every(l=>canPlaceEmperor(g,B,chooseEmperorSquare(g,B,l)));})());

  // ----- Repetition -----
  s=blank();put(s,2,3,3,W,"squire");put(s,2,2,2,B,"squire");
  const k0=positionKey(s);
  applyMove(s,{type:"rotate",f:2,dir:1});
  applyMove(s,{type:"rotate",f:2,dir:-1});
  check("Rotating right then left restores the same position (same side to move)",positionKey(s)===k0);
  check("Position key includes the side to move",positionKey(s)!==positionKey({...s,turn:other(s.turn)}));
  s=blank();declareDraw(s,"test");
  check("A draw ends the game with no winner",s.over&&s.winner===null);

  // ----- Plurality (majority of the board) -----
  check("Plurality thresholds are 5 / 13 / 25 (half the squares plus one)",fieldThreshold(0)===5&&fieldThreshold(1)===13&&fieldThreshold(2)===25&&fieldThreshold(3)===13&&fieldThreshold(4)===5);
  const plur=()=>newState({mode:"plurality",target:15});
  s=plur();for(let c=0;c<3;c++)put(s,0,0,c,W,"squire");put(s,0,1,0,W,"squire");
  check("Plurality: 4 Squires in a 3×3 do not hold it",fieldOwner(s,0)===null);
  put(s,0,1,1,W,"squire");
  check("Plurality: 5 Squires hold the 3×3",fieldOwner(s,0)===W);
  s=plur();put(s,0,0,0,W,"squire");put(s,0,0,1,W,"squire");put(s,0,1,0,W,"marshal");
  check("Plurality: a Marshal counts 3 (2 Squires + Marshal = 5 holds the 3×3)",fieldInfluence(s,0).white===5&&fieldOwner(s,0)===W);
  s=plur();put(s,0,0,0,W,"squire");put(s,0,0,1,W,"knight");put(s,0,0,2,W,"knight");
  check("Plurality: a Knight counts 2 (1 + 2 + 2 = 5 holds the 3×3)",fieldInfluence(s,0).white===5&&fieldOwner(s,0)===W);
  s=plur();for(let c=0;c<3;c++)put(s,0,0,c,W,"squire");put(s,0,1,0,W,"squire");put(s,0,1,1,W,"squire");
  put(s,0,2,0,B,"knight");put(s,0,2,1,B,"knight");put(s,0,2,2,B,"marshal");
  check("Plurality: if both reach the threshold, the higher presence holds it (Black 7 vs White 5)",fieldOwner(s,0)===B);
  put(s,0,1,2,W,"knight");
  check("Plurality: equal presence holds nothing (7 vs 7)",fieldInfluence(s,0).white===7&&fieldInfluence(s,0).black===7&&fieldOwner(s,0)===null);
  s=newState({mode:"hill"});for(let c=0;c<3;c++)put(s,0,0,c,W,"squire");
  check("King of the Hill is unchanged: plain majority of influence still holds a field (3 vs 0)",fieldOwner(s,0)===W);
  s=plur();put(s,0,0,0,W,"squire");put(s,4,0,0,B,"squire");s.turns.white=3;
  applyMove(s,{type:"place",kind:"squire",f:0,r:0,c:1});
  check("Plurality: a field below its threshold earns nothing even on a scoring turn",s.points.white===0);
  s=plur();for(let c=0;c<3;c++)put(s,0,0,c,W,"squire");put(s,0,1,0,W,"squire");put(s,4,0,0,B,"squire");s.turns.white=3;
  applyMove(s,{type:"place",kind:"squire",f:0,r:1,c:1});
  check("Plurality: once a field reaches its threshold it scores its value (3×3 = 1)",s.points.white===1);
  s=newState({mode:"plurality",target:15});put(s,0,0,0,W,"squire");put(s,4,0,0,B,"squire");
  check("Plurality position key includes the score (so scoring turns never repeat a position)",
    positionKey(s)!==positionKey({...s,points:{white:1,black:0}}));
  g=createGame({mode:"plurality"});
  check("Plurality starts like King of the Hill (3-Squire road each, no Emperors)",findPieces(g,W,"squire").length===3&&findPieces(g,W,"emperor").length===0);
  {let ok2=true;for(const level of["easy","normal","optimized"]){const m=chooseAI(cloneState(g),level,"white");ok2=ok2&&!!m&&legalMoves(g,"white").some(l=>JSON.stringify(l)===JSON.stringify(m))}
   check("AI returns legal moves in Plurality at every level",ok2);}

  check("Plurality scoring starts on turn 4 for both sides (Hill keeps 4 / 3)",
    startTurnOf(newState({mode:"plurality"}),W)===4&&startTurnOf(newState({mode:"plurality"}),B)===4&&
    startTurnOf(newState({mode:"hill"}),W)===4&&startTurnOf(newState({mode:"hill"}),B)===3);
  s=newState({mode:"plurality",target:10});put(s,0,0,0,W,"squire");put(s,4,0,0,B,"squire");
  s.points.white=10;s.points.black=10;s.turns.black=5;s.turn=B;
  for(const c of[0,1,2])put(s,0,1,c,W,"squire");put(s,0,2,0,W,"squire");put(s,0,2,1,W,"squire");
  applyMove(s,{type:"place",kind:"squire",f:4,r:0,c:1});
  check("Plurality: a tie at the target goes to the side with more total presence on the board",s.over&&s.winner===W&&/more total presence/.test(s.endReason));
  s=newState({mode:"plurality",target:10});for(const c of[0,1,2])put(s,0,0,c,W,"squire");put(s,4,0,0,B,"squire");put(s,4,0,1,B,"squire");
  s.points.white=10;s.points.black=10;s.turns.black=5;s.turn=B;
  applyMove(s,{type:"place",kind:"squire",f:4,r:0,c:2});
  check("Plurality: equal presence at a tied target means play continues",!s.over);

  // ----- Emperor start (Emperor only) and flank-immune squares -----
  g=emperorGame();
  check("Emperor start: no Squires on the board, only the Emperors",
    findPieces(g,W,"squire").length===0&&findPieces(g,B,"squire").length===0&&countPieces(g,W)===1&&countPieces(g,B)===1);
  check("Emperor start: White's only legal moves are Squires beside its Emperor",
    legalMoves(g,W).length===4&&legalMoves(g,W).every(m=>m.type==="place"&&m.kind==="squire"));
  check("Emperor start: no rotation or Marshal yet (needs Squires)",!hasLegalMoveOfType(g,W,"rotate")&&!hasLegalMoveOfType(g,W,"marshal"));
  const immune={straight:2,zigzag:2,block:2};
  for(const name of Object.keys(LAYOUTS)){
    const gs=createGame({layoutName:name,mode:"emperor",emperorSetup:true});
    let n=0;for(let r=0;r<3;r++)for(let c=0;c<3;c++)if(!isFlankable(gs,{f:0,r,c}))n++;
    check(`${name}: exactly ${immune[name]} of White's 9 home squares can never be flanked`,n===immune[name]);

    // Property: on every square where an Emperor may be placed, an attacker CAN bracket it,
    // using two squares that are themselves flankable (so no permanent corner lock).
    let allowedSquares=0,bad=0;
    for(const color of[W,B])for(const f of emperorFields(color))
      for(let r=0;r<SIZES[f];r++)for(let c=0;c<SIZES[f];c++){
        const sq={f,r,c};
        if(!canPlaceEmperor(gs,color,sq))continue;
        allowedSquares++;
        const foe=other(color);
        const ok=[[[1,0],[-1,0]],[[0,1],[0,-1]]].some(([a,b])=>{
          const n1=step(gs,sq,a[0],a[1]),n2=step(gs,sq,b[0],b[1]);
          if(!n1||!n2||!isFlankable(gs,n1)||!isFlankable(gs,n2))return false;
          const t=cloneState(gs);t.phase="play";
          t.fields[f].grid[r][c]={color,kind:"emperor"};
          t.fields[n1.f].grid[n1.r][n1.c]={color:foe,kind:"squire"};
          return linesFrom(t,n2,foe).some(l=>l.run.length===1&&keyOf(l.run[0])===keyOf(sq));
        });
        if(!ok)bad++;
      }
    check(`${name}: every allowed Emperor square can really be bracketed (${allowedSquares} squares checked)`,allowedSquares>0&&bad===0);
  }
  {
    const z=createGame({layoutName:"zigzag",mode:"emperor",emperorSetup:true});
    check("Zig-zag: the corner-lock square from play-testing (Black row2,col3) is not allowed",!canPlaceEmperor(z,B,{f:4,r:1,c:2}));
    check("Zig-zag: Black's immune corner and its centre square behave as expected",!canPlaceEmperor(z,B,{f:4,r:2,c:2})&&canPlaceEmperor(z,B,{f:4,r:1,c:1}));
    const st=createGame({layoutName:"straight",mode:"emperor",emperorSetup:true});
    check("Straight: the edge square between two immune corners is not allowed, the centre is",!canPlaceEmperor(st,W,{f:0,r:1,c:0})&&canPlaceEmperor(st,W,{f:0,r:1,c:1}));
    check("Emperor may go in your own 5×5 (not the 7×7, not the enemy's fields)",
      canPlaceEmperor(st,W,{f:1,r:2,c:2})&&canPlaceEmperor(st,B,{f:3,r:2,c:2})&&
      !canPlaceEmperor(st,W,{f:2,r:3,c:3})&&!canPlaceEmperor(st,W,{f:3,r:2,c:2})&&!canPlaceEmperor(st,W,{f:4,r:1,c:1}));
    st.picks.white={f:1,r:2,c:2};st.picks.black={f:3,r:2,c:2};revealEmperors(st);
    check("An Emperor placed in a 5×5 appears there after the reveal",st.fields[1].grid[2][2].kind==="emperor"&&st.fields[3].grid[2][2].kind==="emperor");
  }
  s=createGame({mode:"emperor"});
  {const gs=emperorBlank();
   put(gs,0,0,2,W,"emperor");put(gs,0,1,1,W,"squire");put(gs,4,0,0,B,"squire");
   check("Rotation that would carry an Emperor onto an uncapturable square is illegal",
     !canRotate(gs,0,W,-1)&&canRotate(gs,0,W,1)&&canRotate(gs,0,W));
   check("The illegal rotation is not offered as a move",
     !legalMoves(gs,W).some(m=>m.type==="rotate"&&m.f===0&&m.dir===-1)&&legalMoves(gs,W).some(m=>m.type==="rotate"&&m.f===0&&m.dir===1));}

  // ----- AI -----
  s=createGame();
  let ok=true;
  for(const level of["easy","normal","optimized"]){
    const m=chooseAI(cloneState(s),level,"white");
    ok=ok&&!!m&&legalMoves(s,"white").some(l=>JSON.stringify(l)===JSON.stringify(m));
  }
  check("AI returns legal moves at both levels",ok);
  s=emperorGame();ok=true;
  for(const level of["dummy","easy","normal","optimized"]){
    const m=chooseAI(cloneState(s),level,"white");
    ok=ok&&!!m&&legalMoves(s,"white").some(l=>JSON.stringify(l)===JSON.stringify(m));
  }
  check("AI returns legal moves in Emperor mode (all levels)",ok);
  s=emperorBlank();put(s,2,3,3,B,"emperor");put(s,2,3,2,W,"squire");put(s,4,0,0,B,"squire");put(s,0,0,0,W,"squire");
  for(const level of["normal","optimized"]){
    const winMove=chooseAI(s,level,"white");
    check(`AI (${level}) takes an available Emperor capture`,winMove&&winMove.type==="place"&&winMove.kind==="knight"&&winMove.c===4);
  }

  return results;
}
